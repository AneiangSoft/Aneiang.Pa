<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aneiang-pa-mcp</ToolCommandName>
    <PackageId>Aneiang.Pa.Mcp</PackageId>

    <!-- Tool 包不应继承仓库的库包元数据（Version/Readme/Icon 等），这里显式覆写 -->
    <IsPackable>true</IsPackable>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageReadmeFile></PackageReadmeFile>
    <PackageIcon></PackageIcon>

    <Version>0.1.0</Version>
    <Authors>AneiangSoft</Authors>
    <Description>Aneiang.Pa MCP Server (dotnet tool). Provides MCP tools for news and lottery queries.</Description>
    <RepositoryUrl>https://github.com/AneiangSoft/Pa.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="..\..\README.md" />
    <None Remove="..\..\assets\icon.png" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aneiang.Pa\Aneiang.Pa.csproj" />
    <ProjectReference Include="..\Aneiang.Pa.AspNetCore\Aneiang.Pa.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="0.4.0-preview.1" />
    <PackageReference Include="ModelContextProtocolServer.Hybrid" Version="0.6.0" />
    <PackageReference Include="ModelContextProtocolServer.Stdio" Version="0.6.0" />
  </ItemGroup>

</Project>
