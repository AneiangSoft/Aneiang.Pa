<Project>

  <!-- ========== 全局属性 ========== -->
  <PropertyGroup>
    <Authors>AneiangSoft</Authors>
    <Company>AneiangSoft</Company>
    <Product>Aneiang.Pa</Product>
    <Version>4.0.0</Version>
    <PackageVersion>4.0.0</PackageVersion>

    <!-- 许可证 -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- 仓库信息 -->
    <PackageProjectUrl>https://github.com/AneiangSoft/Aneiang.Pa</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AneiangSoft/Aneiang.Pa.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- 图标与 README -->
    <PackageIcon>icon.png</PackageIcon>

    <!-- 发布配置 -->
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)nupkgs</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- 文档与可见性 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SuppressWarnings>$(SuppressWarnings);1591</SuppressWarnings>

    <!-- 编译配置 -->
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- ========== 图标与 README（所有可打包项目共享） ========== -->
  <ItemGroup Condition="'$(IsPackable)' == 'true' AND '$(MSBuildProjectName)' != 'HelloPa' AND '$(MSBuildProjectName)' != 'CustomRecipe' AND '$(MSBuildProjectName)' != 'PaWeb' AND '$(MSBuildProjectName)' != 'DouYinDemo' AND '$(MSBuildProjectName)' != 'Aneiang.Pa.Tests'">
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="icon.png" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="README.md" Condition="'$(PackageReadmeFile)' == ''" />
  </ItemGroup>

  <!-- ========== 标签（可被各项目覆盖） ========== -->
  <PropertyGroup>
    <PackageTags>scraper;spider;crawler;news;hot-search;trending;yaml;recipe;pipeline;dotnet</PackageTags>
  </PropertyGroup>

</Project>
